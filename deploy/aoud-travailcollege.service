[Unit]
Description=Travail college (PocketBase : site, comptes, cours, travaux)
After=network.target

[Service]
User=pocketbase
Group=pocketbase
WorkingDirectory=/opt/aoud-travailcollege
ExecStart=/opt/aoud-travailcollege/pocketbase serve \
  --http=127.0.0.1:8090 \
  --dir=/opt/aoud-travailcollege/pb_data \
  --migrationsDir=/opt/aoud-travailcollege/repo/deploy/pb_migrations \
  --publicDir=/opt/aoud-travailcollege/repo/deploy/pb_public
Restart=always
RestartSec=3
LimitNOFILE=4096
# Durcissement léger
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/aoud-travailcollege

[Install]
WantedBy=multi-user.target
